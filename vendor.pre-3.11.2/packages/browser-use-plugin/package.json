    "@zcode/adapters": "workspace:*",
    "@zcode/bootstrap": "workspace:*",
    "esbuild": "^0.25.0",
    "playwright-core": "1.59.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
