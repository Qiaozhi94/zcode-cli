{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/browser-use-plugin",
  "version": "0.4.2",
  "private": true,
  "description": "作为官方 ZCode 内置插件发布的 Browser Use skill、client runtime 与无状态 node_repl MCP server。",
  "license": "MIT",
  "type": "module",
